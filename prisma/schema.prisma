generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model agent_brokerages {
  id                     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  agent_id               BigInt    @db.UnsignedBigInt
  policy_ids             String    @db.Text
  total_brokerage_amount Decimal   @db.Decimal(10, 2)
  payment_method         String    @db.VarChar(255)
  payment_details        String?   @db.Text
  payment_date           DateTime  @db.Date
  created_at             DateTime? @db.Timestamp(0)
  updated_at             DateTime? @db.Timestamp(0)
  agents                 agents    @relation(fields: [agent_id], references: [id], onUpdate: Restrict, map: "agent_brokerages_agent_id_foreign")

  @@index([agent_id], map: "agent_brokerages_agent_id_foreign")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model agents {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name             String             @db.VarChar(255)
  email            String?            @db.VarChar(255)
  phone_no         String             @db.VarChar(255)
  address          String             @db.LongText
  brokerage_rate   Decimal?           @db.Decimal(6, 2)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  agent_brokerages agent_brokerages[]
  customers        customers[]
  policies         policies[]
}

model claims_master {
  id                     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id            BigInt    @db.UnsignedBigInt
  policy_id              BigInt    @db.UnsignedBigInt
  claim_no               String?   @db.VarChar(255)
  insurer_ref_no         String?   @db.VarChar(255)
  claimed                String?   @db.VarChar(255)
  date_of_intimation     DateTime? @db.Date
  date_of_loss           DateTime? @db.Date
  nature_of_loss         String?   @db.VarChar(255)
  estimated_loss         String?   @db.VarChar(255)
  particular_of_surveyor String?   @db.VarChar(255)
  date_of_settlement     DateTime? @db.Date
  amount_settled         String?   @db.VarChar(255)
  status                 String?   @db.VarChar(255)
  timeline               String?   @db.Text
  created_at             DateTime? @db.Timestamp(0)
  updated_at             DateTime? @db.Timestamp(0)
  customers              customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "claims_master_customer_id_foreign")
  policies               policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "claims_master_policy_id_foreign")

  @@index([customer_id], map: "claims_master_customer_id_foreign")
  @@index([policy_id], map: "claims_master_policy_id_foreign")
}

model company_brokerages {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  policy_ids      String    @db.LongText
  received_amount Decimal   @db.Decimal(10, 2)
  gst             Decimal?  @db.Decimal(10, 2)
  payment_method  String?   @db.VarChar(255)
  payment_details String?   @db.Text
  payment_date    DateTime  @db.Date
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model customers {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  name          String          @db.VarChar(255)
  email         String?         @db.VarChar(255)
  phone_no      String          @db.VarChar(255)
  address       String          @db.LongText
  agent_id      BigInt?         @db.UnsignedBigInt
  created_at    DateTime?       @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  claims_master claims_master[]
  agents        agents?         @relation(fields: [agent_id], references: [id], onUpdate: Restrict, map: "customers_agent_id_foreign")
  healths       healths[]
  policies      policies[]

  @@index([agent_id], map: "customers_agent_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model fires {
  id                                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  policy_id                            BigInt    @db.UnsignedBigInt
  risk_location_address                String    @db.Text
  building_including_plinth_foundation Decimal   @db.Decimal(10, 2)
  plinth_and_foundation                Decimal   @db.Decimal(10, 2)
  furniture_fixture_and_fitting        Decimal   @db.Decimal(10, 2)
  plant_machinery_and_accessories      Decimal   @db.Decimal(10, 2)
  stock                                Decimal   @db.Decimal(10, 2)
  any_other                            Decimal   @db.Decimal(10, 2)
  total                                Decimal   @db.Decimal(10, 2)
  created_at                           DateTime? @db.Timestamp(0)
  updated_at                           DateTime? @db.Timestamp(0)
  policies                             policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fire_policy_id_foreign")

  @@index([policy_id], map: "fire_policy_id_foreign")
}

model healths {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  policy_id   BigInt    @db.UnsignedBigInt
  customer_id BigInt    @db.UnsignedBigInt
  member_name String    @db.VarChar(255)
  birthday    DateTime  @db.Date
  relation    String    @db.VarChar(255)
  sum_insured Decimal   @db.Decimal(10, 2)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "healths_customer_id_foreign")
  policies    policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "healths_policy_id_foreign")

  @@index([customer_id], map: "healths_customer_id_foreign")
  @@index([policy_id], map: "healths_policy_id_foreign")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model insurance_policies {
  unnamed__0  String? @map("unnamed:_0") @db.Text
  unnamed__1  String? @map("unnamed:_1") @db.Text
  unnamed__2  String? @map("unnamed:_2") @db.Text
  unnamed__3  Float?  @map("unnamed:_3")
  unnamed__4  String? @map("unnamed:_4") @db.Text
  unnamed__5  String? @map("unnamed:_5") @db.Text
  unnamed__6  String? @map("unnamed:_6") @db.Text
  unnamed__7  String? @map("unnamed:_7") @db.Text
  unnamed__8  String? @map("unnamed:_8") @db.Text
  unnamed__9  String? @map("unnamed:_9") @db.Text
  unnamed__10 String? @map("unnamed:_10") @db.Text
  unnamed__11 String? @map("unnamed:_11") @db.Text
  unnamed__12 String? @map("unnamed:_12") @db.Text
  unnamed__13 String? @map("unnamed:_13") @db.Text
  unnamed__14 String? @map("unnamed:_14") @db.Text
  unnamed__15 String? @map("unnamed:_15") @db.Text
  unnamed__16 String? @map("unnamed:_16") @db.Text
  unnamed__17 String? @map("unnamed:_17") @db.Text
  unnamed__18 String? @map("unnamed:_18") @db.Text
  unnamed__19 String? @map("unnamed:_19") @db.Text
  unnamed__20 String? @map("unnamed:_20") @db.Text
  unnamed__21 String? @map("unnamed:_21") @db.Text
  unnamed__22 String? @map("unnamed:_22") @db.Text
  unnamed__23 String? @map("unnamed:_23") @db.Text
  unnamed__24 String? @map("unnamed:_24") @db.Text
  unnamed__25 String? @map("unnamed:_25") @db.Text
  unnamed__26 String? @map("unnamed:_26") @db.Text

  @@ignore
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model motors {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_reg_no String    @db.VarChar(255)
  vehicle_name   String    @db.VarChar(255)
  mfg_year       Int       @db.Year
  engine_no      String    @db.VarChar(255)
  cc             String    @db.VarChar(255)
  chasis_no      String    @db.VarChar(255)
  hypothecation  String    @db.VarChar(255)
  policy_id      BigInt    @db.UnsignedBigInt
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  policies       policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "motors_policy_id_foreign")

  @@index([policy_id], map: "motors_policy_id_foreign")
}

model password_resets {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model payments {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  policy_id    BigInt    @db.UnsignedBigInt
  payment_type String    @db.VarChar(255)
  cheque_no    String?   @db.VarChar(255)
  bank_name    String?   @db.VarChar(255)
  branch_name  String?   @db.VarChar(255)
  pay_date     DateTime  @db.Date
  amount       Decimal   @db.Decimal(10, 2)
  note         String?   @db.Text
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  policies     policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "payments_policy_id_foreign")

  @@index([policy_id], map: "payments_policy_id_foreign")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model policies {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  renew_id            BigInt?               @db.UnsignedBigInt
  c_name              String                @db.VarChar(255)
  group               String                @db.VarChar(255)
  address             String                @db.VarChar(255)
  mobile_no           String                @db.VarChar(255)
  insurer_name        String                @db.VarChar(255)
  p_type              String                @db.VarChar(255)
  p_name              String                @db.VarChar(255)
  installment         policies_installment?
  p_number            String                @unique(map: "policies_p_number_unique") @db.VarChar(255)
  company_specific_id String?               @db.VarChar(255)
  p_center            String?               @db.VarChar(255)
  tpa                 String?               @db.VarChar(255)
  hypothecation       String?               @db.VarChar(255)
  start_date          DateTime              @db.Date
  end_date            DateTime              @db.Date
  sub_ins             Decimal               @db.Decimal(10, 2)
  companyBrokerage    Decimal               @db.Decimal(10, 2)
  tp_motor            Decimal               @db.Decimal(10, 2)
  basic               Decimal               @db.Decimal(10, 2)
  terr                Decimal               @db.Decimal(10, 2)
  eq                  Decimal               @db.Decimal(10, 2)
  other               Decimal               @db.Decimal(10, 2)
  stfi                Decimal               @db.Decimal(10, 2)
  gst                 Decimal               @db.Decimal(10, 2)
  receipt_date        DateTime              @db.Date
  total               Decimal               @db.Decimal(10, 2)
  remark              String?               @db.LongText
  customer_id         BigInt?               @db.UnsignedBigInt
  refered_by          BigInt?               @db.UnsignedBigInt
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  endorse_date        DateTime?             @db.Date
  endorsement_no      String?               @db.VarChar(255)
  endorse_detail      String?               @db.Text
  claims_master       claims_master[]
  fires               fires[]
  healths             healths[]
  motors              motors[]
  payments            payments[]
  customers           customers?            @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "policies_customer_id_foreign")
  agents              agents?               @relation(fields: [refered_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "policies_refered_by_foreign")
  policies            policies?             @relation("policiesTopolicies", fields: [renew_id], references: [id], onUpdate: Restrict, map: "policies_renew_id_foreign")
  other_policies      policies[]            @relation("policiesTopolicies")
  quotations          quotations[]
  timeline_entries    timeline_entries[]

  @@index([customer_id], map: "policies_customer_id_foreign")
  @@index([refered_by], map: "policies_refered_by_foreign")
  @@index([renew_id], map: "policies_renew_id_foreign")
}

model quotations {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  policy_id     BigInt    @db.UnsignedBigInt
  c_name        String    @db.VarChar(255)
  customer_id   String    @db.VarChar(255)
  address       String?   @db.VarChar(255)
  mobile_no     String?   @db.VarChar(255)
  group         String?   @db.VarChar(255)
  insurer_name  String    @db.VarChar(255)
  p_type        String    @db.VarChar(255)
  p_name        String    @db.VarChar(255)
  p_number      String?   @db.VarChar(255)
  p_center      String?   @db.VarChar(255)
  tpa           String?   @db.VarChar(255)
  hypothecation String?   @db.VarChar(255)
  sub_ins       Decimal?  @db.Decimal(10, 2)
  tp_motor      Decimal   @default(0.00) @db.Decimal(10, 2)
  basic         Decimal   @db.Decimal(10, 2)
  terr          Decimal   @default(0.00) @db.Decimal(10, 2)
  eq            Decimal   @default(0.00) @db.Decimal(10, 2)
  other         Decimal   @default(0.00) @db.Decimal(10, 2)
  stfi          Decimal   @default(0.00) @db.Decimal(10, 2)
  gst           Decimal   @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  remark        String?   @db.Text
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  policies      policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "quotations_policy_id_foreign")

  @@index([policy_id], map: "quotations_policy_id_foreign")
}

model timeline_entries {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  policy_id  BigInt    @db.UnsignedBigInt
  content    String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  policies   policies  @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "timeline_entries_policy_id_foreign")

  @@index([policy_id], map: "timeline_entries_policy_id_foreign")
}

model users {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name              String    @db.VarChar(255)
  email             String?   @db.VarChar(255)
  username          String    @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  role              String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
}

enum policies_installment {
  Monthly
  Quarterly
  Half_Yearly @map("Half-Yearly")
  Yearly
}
